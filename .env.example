PORT=1074
NODE_ENV=development
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# For persistent hosting, set DATABASE_PATH and UPLOADS_DIR to persistent disk paths.
# DATABASE_PATH=data/dordor.sqlite
# UPLOADS_DIR=uploads
# Rubika bot: token stays on the server; never share it in chat or source control.
RUBIKA_BOT_TOKEN=
RUBIKA_BOT_USERNAME=
# Optional TURN credentials for real-time media; set only if your provider supplies them.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
